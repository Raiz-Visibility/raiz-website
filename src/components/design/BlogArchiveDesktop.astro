---
import ImageSlot from "../ImageSlot.astro";
import { getPosts, card, filters } from "../../data/blog";
const all = await getPosts();
const featuredPost = all.find((p) => p.data.featured) ?? all[0];
const featured = featuredPost && { ...card(featuredPost), author: featuredPost.data.author };
const posts = all.filter((p) => p !== featuredPost).map(card);
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<section data-screen-label="Blog hero" style="padding:120px 72px 64px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:end;">
        <div style="grid-column:1 / span 8;display:flex;flex-direction:column;gap:28px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Blog</span>
          <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:64px;line-height:1.05;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">Notes on how home service businesses get found.</h1>
        </div>
        <div style="grid-column:9 / span 4;">
          <p style="margin:0;font-size:17px;line-height:1.6;color:rgba(15,15,18,0.70);text-wrap:pretty;">Search, ads, websites and AI visibility — what's changing, and what to do about it.</p>
        </div>
      </div>
    </section>

    <section data-screen-label="Filters" style="padding:0 72px 48px;">
      <div style="max-width:1320px;margin:0 auto;display:flex;gap:8px;flex-wrap:wrap;padding-bottom:24px;border-bottom:1px solid rgba(15,15,18,0.10);">
        {filters.map((f) => (
<button type="button" class="chip" data-filter={f.key} aria-pressed={f.key === "All" ? "true" : "false"} style={`height:40px;padding:0 16px;display:inline-flex;align-items:center;gap:8px;border-radius:999px;border:1px solid var(--chip-border);background:var(--chip-bg);color:var(--chip-color);font-family:inherit;font-size:14px;cursor:pointer;user-select:none;`}><span style={`width:10px;height:10px;border-radius:3px;background:${f.accent};`}></span>{f.label}</button>
))}
      </div>
    </section>

    {featured && (<div data-featured data-cat={featured.cat}>
      <section data-screen-label="Featured post" style="padding:0 72px 72px;">
        <a href={u(featured.href)} style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;color:inherit;">
          <div style="grid-column:1 / span 7;aspect-ratio:16/10;border-radius:16px;overflow:hidden;">
            <ImageSlot id={featured.slot} shape="rounded" radius={16} placeholder="Featured image" />
          </div>
          <div style="grid-column:9 / span 4;display:flex;flex-direction:column;gap:18px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <span style={`width:10px;height:10px;border-radius:3px;background:${featured.accent};`}></span>
              <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Featured · {featured.cat}</span>
            </div>
            <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:600;font-size:38px;line-height:1.12;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">{featured.title}</h2>
            <p style="margin:0;font-size:16px;line-height:1.6;color:rgba(15,15,18,0.70);text-wrap:pretty;">{featured.excerpt}</p>
            <span style="font-size:13px;color:rgba(15,15,18,0.55);">{featured.author} · {featured.date} · {featured.read}</span>
            <span style="font-size:15px;font-weight:500;color:var(--rz-purple);">Read the post →</span>
          </div>
        </a>
      </section>
    </div>)}

    <section data-screen-label="Post grid" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:flex;flex-direction:column;gap:56px;">
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 24px;">
          {posts.map((p) => (
<a href={u(p.href)} data-post data-cat={p.cat} style="display:flex;flex-direction:column;gap:16px;color:inherit;">
              <div style="aspect-ratio:3/2;border-radius:14px;overflow:hidden;background:#F2F2F5;">
                <ImageSlot id={p.slot} shape="rounded" radius={14} placeholder="Post image" />
              </div>
              <div style="display:flex;align-items:center;gap:10px;">
                <span style={`width:10px;height:10px;border-radius:3px;background:${p.accent};`}></span>
                <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">{p.cat}</span>
              </div>
              <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);text-wrap:pretty;">{p.title}</h3>
              <p style="margin:0;font-size:15px;line-height:1.6;color:rgba(15,15,18,0.68);text-wrap:pretty;">{p.excerpt}</p>
              <span style="font-size:13px;color:rgba(15,15,18,0.55);">{p.date} · {p.read}</span>
            </a>
))}
        </div>
        <p data-empty hidden style="margin:0;font-size:16px;color:rgba(15,15,18,0.6);">No posts in this category yet.</p>
      </div>
    </section>

    <section data-screen-label="Closing CTA" style="padding:0 72px 120px;">
      <div style="max-width:1100px;margin:0 auto;background:var(--rz-gradient-surface);border:1px solid var(--rz-border);border-radius:12px;padding:80px;display:flex;flex-direction:column;align-items:center;gap:32px;">
        <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-foreground);text-align:center;max-width:640px;text-wrap:pretty;">Reading is good. Seeing your own numbers is better.</h2>
        <rz-orb-button href={u("/#contact")} data-section-link="contact" height="52" padding="32">Contact Us</rz-orb-button>
      </div>
    </section>
