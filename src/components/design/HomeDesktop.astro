                <div style="width:62%;padding:18px 0 20px 20px;">
                  <div style="font-size:10px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:var(--rz-slate);margin-bottom:9px;">Commercial painting</div>
                  <div style="font-family:var(--rz-font-display);font-size:29px;font-weight:500;line-height:1.1;color:var(--rz-gold);">67%</div>
                  <div style="font-size:12px;line-height:1.45;color:var(--rz-foreground);margin-top:7px;">of the area now ranks top three</div>
