---
import ImageSlot from '../ImageSlot.astro';
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<!-- 1 · HERO -->
    <section data-screen-label="Hero" style="background:var(--rz-foreground);padding:140px 72px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;">
        <div style="grid-column:1 / span 9;display:flex;flex-direction:column;gap:34px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Search &amp; AI Visibility · Home Services</span>
          <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:72px;line-height:1.05;letter-spacing:-0.02em;color:var(--rz-background);max-width:1000px;text-wrap:pretty;">When someone asks AI for the best in your business, we make sure <span style="background:var(--rz-gradient-brand);-webkit-background-clip:text;background-clip:text;color:transparent;">you're the answer.</span></h1>
          <p style="margin:0;font-size:19px;line-height:1.6;color:rgba(15,15,18,0.70);max-width:560px;">One clear story about your business, everywhere the machines look.</p>
          <div>
            <rz-orb-button href={u("/contact/")} height="52" padding="32">Book a Call</rz-orb-button>
          </div>
        </div>
      </div>
    </section>

    <div class="bleed" style="--bleed:linear-gradient(180deg,#FAFAFA 0%,#E3E4ED 48%,#FAFAFA 82%,#FAFAFA 100%);background:linear-gradient(180deg,#FAFAFA 0%,#E3E4ED 48%,#FAFAFA 82%,#FAFAFA 100%);">
    <!-- 2 · WHAT'S CHANGED -->
    <section data-screen-label="What's changed" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;">
        <div style="grid-column:1 / span 6;display:flex;flex-direction:column;gap:24px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">How we get you found</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-background);max-width:520px;text-wrap:pretty;">We give AI every reason to name you.</h2>
          <p style="margin:0;font-size:16px;line-height:1.625;color:rgba(15,15,18,0.78);max-width:520px;text-wrap:pretty;">New customers aren’t finding you, and it’s hard to fix when no one can tell you why. Our process handles the three things AI checks before it recommends a business, so when someone asks who to call, it names you.</p>
          <div style="display:flex;flex-direction:column;gap:16px;max-width:520px;">
            <p style="margin:0;font-size:16px;line-height:1.625;color:rgba(15,15,18,0.78);text-wrap:pretty;"><span style="font-weight:600;color:var(--rz-background);">We make it clear who you are.</span> One clear story about what you do and where, on your website and Google Business Profile, so AI matches you to the right questions.</p>
            <p style="margin:0;font-size:16px;line-height:1.625;color:rgba(15,15,18,0.78);text-wrap:pretty;"><span style="font-weight:600;color:var(--rz-background);">We build continuity.</span> We put the same facts on your listings, directories, other sites, and published press releases. When what AI finds elsewhere matches what you say, it trusts what it knows.</p>
            <p style="margin:0;font-size:16px;line-height:1.625;color:rgba(15,15,18,0.78);text-wrap:pretty;"><span style="font-weight:600;color:var(--rz-background);">We build the proof.</span> We help you collect reviews and turn your best jobs into case studies, so AI can see you're a good company to hire.</p>
          </div>
        </div>

        <div style="grid-column:7 / span 6;">
          <div style="position:relative;width:100%;aspect-ratio:16/10;background:var(--rz-card);border:1px solid var(--rz-border);border-radius:12px;padding:36px;display:flex;flex-direction:column;justify-content:space-between;">
            <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-muted-foreground);">Video</span>
            <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;">
              <p style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:26px;line-height:1.3;color:var(--rz-foreground);max-width:340px;text-wrap:pretty;">How the machines decide who gets named.</p>
              <span style="flex:0 0 auto;width:52px;height:52px;border-radius:999px;border:2px solid var(--rz-foreground);display:flex;align-items:center;justify-content:center;color:var(--rz-foreground);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
              </span>
            </div>
            <span style="position:absolute;top:32px;right:32px;font-size:11px;color:var(--rz-muted-foreground);">Poster frame — video to come</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · EVIDENCE -->
    <section data-screen-label="Evidence" style="padding:120px 72px;">
      <div style="max-width:1320px;margin:0 auto;">

        <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;">
          <div style="grid-column:1 / span 5;">
            <div style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);margin-bottom:18px;">The evidence · Local SEO</div>
