                </div>
              </div>
              <figure style="position:absolute;left:40%;right:0;top:52px;margin:0;transform:rotate(2deg);z-index:3;">
                <figcaption style="font-size:10px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--rz-background);margin-bottom:10px;">After</figcaption>
                <div style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:12px;box-shadow:0 30px 60px rgba(15,15,18,0.26),0 8px 18px rgba(15,15,18,0.16);overflow:hidden;"><ImageSlot id="evidence-1-after" shape="rect" alt="Septic system service map scan, Jan 15: 66 of 81 points in the top three" placeholder="After scan — drop screenshot" /></div>
              </figure>
            </div>
          </div>
          <div style="flex:0 0 100%;padding:14px 72px 96px 72px;">
            <div style="position:relative;height:460px;">
              <figure style="position:absolute;left:0;top:0;width:38%;margin:0;transform:rotate(-3deg);z-index:1;opacity:0.62;">
                <div style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:12px;overflow:hidden;"><ImageSlot id="evidence-2-before" shape="rect" alt="Commercial painting company map scan, Sept 12: 5 of 64 points in the top three" placeholder="Before scan — drop screenshot" /></div>
                <figcaption style="font-size:10px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:rgba(15,15,18,0.42);margin-top:10px;">Before</figcaption>
              </figure>
