            <div style="position:relative;height:460px;">
              <figure style="position:absolute;left:0;top:0;width:38%;margin:0;transform:rotate(-3deg);z-index:1;opacity:0.62;">
                <div style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:12px;overflow:hidden;"><ImageSlot id="evidence-1-before" shape="rect" alt="Septic system service map scan, Jan 7: 1 of 81 points in the top three" placeholder="Before scan — drop screenshot" /></div>
