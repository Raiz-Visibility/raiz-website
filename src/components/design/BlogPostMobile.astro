---
import ImageSlot from '../ImageSlot.astro';
import type { MarkdownHeading } from 'astro';
import { authors, categories } from '../../data/site';
import type { Post } from '../../data/blog';
import { card, formatDate } from '../../data/blog';
interface Props { post: Post; headings?: MarkdownHeading[]; related: Post[] }
const { post, headings = [], related: relatedPosts } = Astro.props;
const d = post.data;
const accent = categories[d.category].accent;
const author = authors[d.author] ?? { role: 'Co-Founder', bio: '', slot: '' };
const related = relatedPosts.map(card);
const toc = headings.filter((h) => h.depth === 2);
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<div style="padding:40px 16px 24px;display:flex;flex-direction:column;gap:18px;">
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);"><span style={`width:10px;height:10px;border-radius:3px;background:${accent};`}></span>{d.category}</span>
      <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:34px;line-height:1.1;letter-spacing:-0.02em;color:var(--rz-background);">{d.title}</h1>
      <span style="font-size:13px;color:rgba(15,15,18,0.55);">{d.author} · {formatDate(d.date)} · {d.readTime}</span>
    </div>
    <div style="margin:0 16px 32px;aspect-ratio:16/10;border-radius:14px;overflow:hidden;"><ImageSlot id={`blog-${post.id}`} shape="rounded" radius={14} placeholder="Hero image" /></div>

    <article class="prose-m"><slot /></article>

    <div style="padding:40px 16px 56px;background:#F2F2F5;display:flex;flex-direction:column;gap:20px;">
      <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:24px;color:var(--rz-background);">Keep reading</h2>
      {related.map((p) => (
<a href={u(p.href)} style="display:flex;flex-direction:column;gap:6px;padding-top:16px;border-top:1px solid rgba(15,15,18,0.10);color:inherit;">
          <span style="display:inline-flex;align-items:center;gap:8px;font-size:10px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:var(--rz-slate-dark);"><span style={`width:8px;height:8px;border-radius:2px;background:${p.accent};`}></span>{p.cat}</span>
          <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:18px;line-height:1.3;color:var(--rz-background);">{p.title}</h3>
        </a>
))}
    </div>

    <div style="padding:40px 16px 56px;">
      <div style="background:var(--rz-gradient-surface);border:1px solid var(--rz-border);border-radius:12px;padding:40px 24px;display:flex;flex-direction:column;align-items:center;gap:24px;">
        <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.3;color:var(--rz-foreground);text-align:center;">Want to know what AI says about you today?</h2>
        <rz-orb-button href={u("/contact/")} height="52" padding="30" full>Book a Call</rz-orb-button>
      </div>
    </div>
