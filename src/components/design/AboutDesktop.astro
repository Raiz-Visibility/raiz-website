---
import ImageSlot from '../ImageSlot.astro';
import { industries } from '../../data/site';
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<section data-screen-label="About hero" style="padding:140px 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;">
        <div style="grid-column:1 / span 10;display:flex;flex-direction:column;gap:34px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">About Raiz</span>
          <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:72px;line-height:1.05;letter-spacing:-0.02em;color:var(--rz-background);max-width:1000px;text-wrap:pretty;">Two people, doing the work <span style="background:var(--rz-gradient-brand);-webkit-background-clip:text;background-clip:text;color:transparent;">ourselves.</span></h1>
          <p style="margin:0;font-size:19px;line-height:1.6;color:rgba(15,15,18,0.70);max-width:600px;text-wrap:pretty;">Raiz Visibility helps home service businesses get found — on the map, in search, and in the answer AI gives when someone asks who to call.</p>
        </div>
      </div>
    </section>

    <section data-screen-label="Our story" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;padding-top:64px;border-top:1px solid rgba(15,15,18,0.10);">
        <div style="grid-column:1 / span 5;display:flex;flex-direction:column;gap:20px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Why we started Raiz</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">Most agencies sell you a channel. Your customers don't search in channels.</h2>
        </div>
        <div style="grid-column:7 / span 6;display:flex;flex-direction:column;gap:20px;">
          <p style="margin:0;font-size:17px;line-height:1.65;color:rgba(15,15,18,0.75);text-wrap:pretty;">A homeowner with a leaking water heater might search Google, check the map, see an ad, ask ChatGPT and read three reviews — all inside ten minutes. Each of those is usually handled by a different vendor, chasing a different number.</p>
          <p style="margin:0;font-size:17px;line-height:1.65;color:rgba(15,15,18,0.75);text-wrap:pretty;">We started Raiz to run the whole loop: search, ads, the site and AI visibility, planned together and measured against the one number that matters — booked jobs.</p>
          <div style="margin-top:20px;display:flex;flex-direction:column;gap:20px;">
            <div style="height:2px;width:120px;background:var(--rz-gradient-purple-slate);"></div>
            <p style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:26px;line-height:1.3;color:var(--rz-background);text-wrap:pretty;">One clear story about your business, everywhere the machines look.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bleed" data-screen-label="Founders" style="--bleed:linear-gradient(#F2F2F5,#F2F2F5);padding:120px 72px;background:#F2F2F5;">
      <div style="max-width:1320px;margin:0 auto;display:flex;flex-direction:column;gap:96px;">
        <div style="display:flex;flex-direction:column;gap:20px;max-width:640px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Who's behind it</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">The two people on your call are the two people in your accounts.</h2>
        </div>

        <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;">
          <div style="grid-column:1 / span 5;aspect-ratio:1;border-radius:16px;overflow:hidden;">
            <ImageSlot id="raiz-founder-1" shape="rounded" radius={16} placeholder="Ryan Maizis — portrait, square" />
          </div>
          <div style="grid-column:7 / span 5;display:flex;flex-direction:column;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <span style="font-family:var(--rz-font-display);font-weight:600;font-size:36px;letter-spacing:-0.02em;color:var(--rz-background);">Ryan Maizis</span>
              <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Co-Founder</span>
            </div>
            <p style="margin:0;font-size:17px;line-height:1.65;color:rgba(15,15,18,0.75);text-wrap:pretty;">[X] years running paid media for [type of client]. Ryan owns the ad accounts and the measurement behind them — every dollar traced from the click, to the call, to the booked job.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">Paid ads</span>
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">Tracking</span>
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">Reporting</span>
            </div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;">
          <div style="grid-column:2 / span 5;grid-row:1;display:flex;flex-direction:column;gap:20px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <span style="font-family:var(--rz-font-display);font-weight:600;font-size:36px;letter-spacing:-0.02em;color:var(--rz-background);">Kyle Sabraw</span>
              <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Co-Founder</span>
            </div>
            <p style="margin:0;font-size:17px;line-height:1.65;color:rgba(15,15,18,0.75);text-wrap:pretty;">Building for search since [year]. Kyle owns the sites, the technical work, and how you show up when a model answers instead of a results page.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">SEO</span>
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">Websites</span>
              <span style="padding:7px 12px;border-radius:999px;border:1px solid rgba(15,15,18,0.14);font-size:13px;color:var(--rz-background);">AI visibility</span>
            </div>
          </div>
          <div style="grid-column:8 / span 5;grid-row:1;aspect-ratio:1;border-radius:16px;overflow:hidden;">
            <ImageSlot id="raiz-founder-2" shape="rounded" radius={16} placeholder="Kyle Sabraw — portrait, square" />
          </div>
        </div>
      </div>
    </section>

    <section data-screen-label="How we work" style="padding:128px 72px;">
      <div style="max-width:1320px;margin:0 auto;display:flex;flex-direction:column;gap:72px;">
        <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:end;">
          <div style="grid-column:1 / span 6;display:flex;flex-direction:column;gap:20px;">
            <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">How we work</span>
            <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">Four things we won't compromise on.</h2>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px;">
          <div style="display:flex;flex-direction:column;gap:14px;border-top:1px solid rgba(15,15,18,0.10);padding-top:24px;">
            <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);">01</span>
            <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">No one in between</h3>
            <p style="margin:0;font-size:15.5px;line-height:1.6;color:rgba(15,15,18,0.7);text-wrap:pretty;">No account managers relaying messages. You talk to the people doing the work.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;border-top:1px solid rgba(15,15,18,0.10);padding-top:24px;">
            <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);">02</span>
            <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">Booked jobs first</h3>
            <p style="margin:0;font-size:15.5px;line-height:1.6;color:rgba(15,15,18,0.7);text-wrap:pretty;">Reporting starts at the jobs on your calendar and works backwards to what brought them in.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;border-top:1px solid rgba(15,15,18,0.10);padding-top:24px;">
            <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);">03</span>
            <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">Everything compounds</h3>
            <p style="margin:0;font-size:15.5px;line-height:1.6;color:rgba(15,15,18,0.7);text-wrap:pretty;">Search, ads and the site are planned together, so each one makes the others work harder.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;border-top:1px solid rgba(15,15,18,0.10);padding-top:24px;">
            <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);">04</span>
            <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">Straight answers</h3>
            <p style="margin:0;font-size:15.5px;line-height:1.6;color:rgba(15,15,18,0.7);text-wrap:pretty;">If we can't move the number for you, we'll say so on the first call.</p>
          </div>
        </div>
      </div>
    </section>

    <section data-screen-label="Who we work with" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;">
        <div style="grid-column:1 / span 4;display:flex;flex-direction:column;gap:20px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Who we work with</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-background);text-wrap:pretty;">Only home services.</h2>
          <p style="margin:0;font-size:16px;line-height:1.625;color:rgba(15,15,18,0.70);text-wrap:pretty;">We already know how your customers search, when your busy season hits, and which jobs are worth chasing.</p>
        </div>
        <div style="grid-column:6 / span 7;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:32px;">
          {industries.map((ind) => (
<a href={u("/industries/")} style="display:flex;align-items:center;justify-content:space-between;padding:18px 0;border-bottom:1px solid rgba(15,15,18,0.10);font-family:var(--rz-font-display);font-size:20px;font-weight:500;color:var(--rz-background);" class="hv-29">{ind}<span style="font-size:16px;color:rgba(15,15,18,0.4);">→</span></a>
))}
        </div>
      </div>
    </section>

    <section data-screen-label="Closing CTA" style="padding:0 72px 120px;">
      <div style="max-width:1100px;margin:0 auto;background:var(--rz-gradient-surface);border:1px solid var(--rz-border);border-radius:12px;padding:80px;display:flex;flex-direction:column;align-items:center;gap:32px;">
        <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-foreground);text-align:center;max-width:640px;text-wrap:pretty;">Thirty minutes with both of us. We'll show you where you stand today.</h2>
        <rz-orb-button href={u("/contact/")} height="52" padding="32">Book a Call</rz-orb-button>
      </div>
    </section>
