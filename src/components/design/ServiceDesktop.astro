---
import ImageSlot from '../ImageSlot.astro';
import type { CollectionEntry } from 'astro:content';
import { industries, categories } from '../../data/site';
interface Props { service: CollectionEntry<'services'>['data']; slug: string }
const { slug } = Astro.props;
const s = Astro.props.service;
const c = categories[s.category];
const { serviceName, category } = s;
const categoryNum = c.num;
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<section data-screen-label="Service hero" style="padding:120px 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;">
        <div style="grid-column:1 / span 10;display:flex;flex-direction:column;gap:32px;">
          <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:rgba(15,15,18,0.55);">
            <a href={u("/services/")} style="color:rgba(15,15,18,0.55);">Services</a><span>/</span>
            <span>{category}</span><span>/</span>
            <span style="color:var(--rz-background);">{serviceName}</span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="width:14px;height:14px;border-radius:4px;background:var(--accent);"></span>
            <span style="font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:var(--rz-slate-dark);">{categoryNum} · {category}</span>
          </div>
          <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:72px;line-height:1.05;letter-spacing:-0.02em;color:var(--rz-background);max-width:1000px;text-wrap:pretty;">{s.hero.title}</h1>
          <p style="margin:0;font-size:19px;line-height:1.6;color:rgba(15,15,18,0.70);max-width:600px;text-wrap:pretty;">{s.hero.lead}</p>
          <div style="display:flex;align-items:center;gap:32px;">
            <rz-orb-button href={u("/#contact")} data-section-link="contact" height="52" padding="32">Contact Us</rz-orb-button>
            <a href="#results" style="font-size:15px;font-weight:500;color:var(--rz-background);">See the results ↓</a>
          </div>
        </div>
      </div>
    </section>

    <section data-screen-label="The problem" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;padding-top:64px;border-top:1px solid rgba(15,15,18,0.10);">
        <div style="grid-column:1 / span 5;display:flex;flex-direction:column;gap:20px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">The problem</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">{s.problem.heading}</h2>
        </div>
        <div style="grid-column:7 / span 6;display:flex;flex-direction:column;gap:20px;">
          {(s.problem.paragraphs).map((p) => (
            <p style="margin:0;font-size:17px;line-height:1.65;color:rgba(15,15,18,0.75);text-wrap:pretty;">{p}</p>
          ))}
          <div style="margin-top:20px;display:flex;flex-direction:column;gap:20px;">
            <div style="height:2px;width:120px;background:var(--accent);"></div>
            <p style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:26px;line-height:1.3;color:var(--rz-background);text-wrap:pretty;">{s.problem.pull}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bleed" data-screen-label="What's included" style="--bleed:linear-gradient(#F2F2F5,#F2F2F5);padding:120px 72px;background:var(--rz-gradient-surface-light, #F2F2F5);">
      <div style="max-width:1320px;margin:0 auto;display:flex;flex-direction:column;gap:72px;">
        <div style="display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:end;">
          <div style="grid-column:1 / span 6;display:flex;flex-direction:column;gap:20px;">
            <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">What's included</span>
            <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">What you get with {serviceName}.</h2>
          </div>
          <div style="grid-column:8 / span 5;">
            <p style="margin:0;font-size:18px;line-height:1.6;color:rgba(15,15,18,0.68);text-wrap:pretty;">{s.included.intro}</p>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;">
          {s.included.items.map((item, i) => (
          <div style="background:var(--rz-foreground);border:1px solid rgba(15,15,18,0.08);border-radius:14px;padding:28px;display:flex;flex-direction:column;gap:14px;min-height:220px;">
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="width:12px;height:12px;border-radius:4px;background:var(--accent);"></span>
                <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 style="margin:auto 0 0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">{item.title}</h3>
              <p style="margin:0;font-size:15px;line-height:1.6;color:rgba(15,15,18,0.68);text-wrap:pretty;">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section data-screen-label="How it works" style="padding:128px 72px;">
      <div style="max-width:1320px;margin:0 auto;display:flex;flex-direction:column;gap:72px;">
        <div style="display:flex;flex-direction:column;gap:20px;max-width:640px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">How it works</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:40px;line-height:1.16;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">{s.steps.heading}</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px;">
          {s.steps.items.map((step, i) => (
          <div style="display:flex;flex-direction:column;gap:14px;">
              <div style="display:flex;align-items:center;gap:12px;">
                <span style="width:36px;height:36px;border-radius:10px;border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:var(--rz-background);">{String(i + 1).padStart(2, '0')}</span>
                <span style="flex:1;height:2px;background:var(--accent);opacity:0.35;"></span>
              </div>
              <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);margin-top:10px;">{step.when}</span>
              <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.25;color:var(--rz-background);">{step.title}</h3>
              <p style="margin:0;font-size:15px;line-height:1.6;color:rgba(15,15,18,0.68);text-wrap:pretty;">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="results" data-screen-label="Results" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;background:var(--rz-background);border-radius:16px;padding:72px;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:center;">
        <div style="grid-column:1 / span 5;display:flex;flex-direction:column;gap:24px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate);">{s.results.label}</span>
          <div style="font-family:var(--rz-font-display);font-weight:600;font-size:88px;line-height:1;letter-spacing:-0.03em;color:var(--accent-on-dark);">{s.results.stat}</div>
          <p style="margin:0;font-size:18px;line-height:1.55;color:var(--rz-foreground);max-width:400px;text-wrap:pretty;">{s.results.statText}</p>
          <div style="height:1px;background:rgba(250,250,250,0.14);"></div>
          <p style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:22px;line-height:1.4;color:var(--rz-foreground);text-wrap:pretty;">{s.results.quote}</p>
          <span style="font-size:13px;color:var(--rz-muted-foreground);">{s.results.attribution}</span>
        </div>
        <div style="grid-column:7 / span 6;display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div style="display:flex;flex-direction:column;gap:10px;">
            <span style="font-size:10px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--rz-muted-foreground);">Before</span>
            <div style="aspect-ratio:1;border-radius:12px;overflow:hidden;"><ImageSlot id={`${slug}-before`} shape="rounded" radius={12} placeholder="Before — drop screenshot" /></div>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;">
            <span style="font-size:10px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--rz-foreground);">After</span>
            <div style="aspect-ratio:1;border-radius:12px;overflow:hidden;"><ImageSlot id={`${slug}-after`} shape="rounded" radius={12} placeholder="After — drop screenshot" /></div>
          </div>
        </div>
      </div>
    </section>

    <section data-screen-label="Industries served" style="padding:0 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;">
        <div style="grid-column:1 / span 4;display:flex;flex-direction:column;gap:20px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Industries served</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-background);text-wrap:pretty;">{serviceName} for the trades we know.</h2>
        </div>
        <div style="grid-column:6 / span 7;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:32px;">
          {industries.map((ind) => (
<a href={u("/industries/")} style="display:flex;align-items:center;justify-content:space-between;padding:18px 0;border-bottom:1px solid rgba(15,15,18,0.10);font-family:var(--rz-font-display);font-size:20px;font-weight:500;color:var(--rz-background);" class="hv-29">{ind}<span style="font-size:16px;color:rgba(15,15,18,0.4);">→</span></a>
))}
        </div>
      </div>
    </section>

    <section data-screen-label="Closing CTA" style="padding:0 72px 120px;">
      <div style="max-width:1100px;margin:0 auto;background:var(--rz-gradient-surface);border:1px solid var(--rz-border);border-radius:12px;padding:80px;display:flex;flex-direction:column;align-items:center;gap:32px;">
        <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:32px;line-height:1.25;color:var(--rz-foreground);text-align:center;max-width:640px;text-wrap:pretty;">{s.cta}</h2>
        <rz-orb-button href={u("/#contact")} data-section-link="contact" height="52" padding="32">Contact Us</rz-orb-button>
      </div>
    </section>
