---
import LeadReportForm from '../LeadReportForm.astro';
const items = [
  'Your top three fixes, in the order to do them.',
  'Which website pages to remove, rework, strengthen or build.',
  'A rewritten Google Business Profile description, services list and post ideas.',
  'How the links pointing at your site compare with local competitors.',
];
---
<section data-screen-label="Free report" style="padding:120px 72px 128px;">
      <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:24px;align-items:start;">
        <div style="grid-column:1 / span 5;display:flex;flex-direction:column;gap:32px;">
          <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Free Local Visibility Report</span>
          <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:64px;line-height:1.05;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">See What's Hurting Your <span style="background:var(--rz-gradient-brand);-webkit-background-clip:text;background-clip:text;color:transparent;">Visibility</span></h1>
          <p style="margin:0;font-size:18px;line-height:1.6;color:rgba(15,15,18,0.70);text-wrap:pretty;">We read your website and Google Business Profile, check them against what Google Maps, AI Overviews and ChatGPT look for, and email you a plain-English plan.</p>

          <div style="display:flex;flex-direction:column;gap:0;margin-top:8px;">
            <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);margin-bottom:8px;">In your report</span>
            {items.map((text, i) => (
              <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid rgba(15,15,18,0.10);">
                <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);padding-top:4px;">{String(i + 1).padStart(2, '0')}</span>
                <p style="margin:0;font-size:16px;line-height:1.55;color:var(--rz-background);">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <div style="grid-column:7 / span 6;background:#F2F2F5;border:1px solid rgba(15,15,18,0.08);border-radius:16px;padding:40px;position:relative;">
          <LeadReportForm variant="d" />
        </div>
      </div>
    </section>
