---
import ImageSlot from "../ImageSlot.astro";
import { getPosts, card, filters } from "../../data/blog";
const all = await getPosts();
const featuredPost = all.find((p) => p.data.featured) ?? all[0];
const featured = featuredPost && { ...card(featuredPost), author: featuredPost.data.author };
const posts = all.filter((p) => p !== featuredPost).map(card);
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<div style="padding:48px 16px 24px;display:flex;flex-direction:column;gap:18px;">
      <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Blog</span>
      <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:36px;line-height:1.08;letter-spacing:-0.02em;color:var(--rz-background);">Notes on how home service businesses get found.</h1>
    </div>

    <div style="padding:0 16px 24px;display:flex;gap:8px;overflow-x:auto;">
      {filters.map((f) => (
<button type="button" class="chip" data-filter={f.key} aria-pressed={f.key === "All" ? "true" : "false"} style={`flex:0 0 auto;height:44px;padding:0 16px;display:inline-flex;align-items:center;gap:8px;border-radius:999px;border:1px solid var(--chip-border);background:var(--chip-bg);color:var(--chip-color);font-family:inherit;font-size:14px;white-space:nowrap;`}><span style={`width:10px;height:10px;border-radius:3px;background:${f.accent};`}></span>{f.short}</button>
))}
    </div>

    <div style="padding:0 16px 56px;display:flex;flex-direction:column;gap:36px;">
      {featured && (<div data-featured data-cat={featured.cat}>
        <a href={u(featured.href)} style="display:flex;flex-direction:column;gap:14px;color:inherit;">
          <div style="aspect-ratio:16/10;border-radius:14px;overflow:hidden;"><ImageSlot id={featured.slot} shape="rounded" radius={14} placeholder="Featured image" /></div>
          <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Featured</span>
          <h2 style="margin:0;font-family:var(--rz-font-display);font-weight:600;font-size:26px;line-height:1.15;color:var(--rz-background);">{featured.title}</h2>
          <span style="font-size:13px;color:rgba(15,15,18,0.55);">{featured.date} · {featured.read}</span>
        </a>
      </div>)}
      {posts.map((p) => (
<a href={u(p.href)} data-post data-cat={p.cat} style="display:flex;gap:14px;color:inherit;padding-top:20px;border-top:1px solid rgba(15,15,18,0.10);">
          <div style="flex:0 0 96px;height:96px;border-radius:10px;overflow:hidden;background:#F2F2F5;"><ImageSlot id={p.slot} shape="rounded" radius={10} placeholder="Image" /></div>
          <div style="display:flex;flex-direction:column;gap:6px;min-width:0;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style={`width:8px;height:8px;border-radius:2px;background:${p.accent};`}></span>
              <span style="font-size:10px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:var(--rz-slate-dark);">{p.short}</span>
            </div>
            <h3 style="margin:0;font-family:var(--rz-font-display);font-weight:500;font-size:17px;line-height:1.3;color:var(--rz-background);">{p.title}</h3>
            <span style="font-size:12px;color:rgba(15,15,18,0.55);">{p.date} · {p.read}</span>
          </div>
        </a>
))}
    </div>
