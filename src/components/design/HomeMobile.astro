---
import ImageSlot from '../ImageSlot.astro';
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<!-- mobile hero -->
    <div style="padding:56px 16px;display:flex;flex-direction:column;gap:24px;">
      <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Search &amp; AI Visibility · Home Services</span>
      <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:38px;line-height:1.08;letter-spacing:-0.02em;color:var(--rz-background);text-wrap:pretty;">When someone asks AI for the best in your business, we make sure <span style="background:var(--rz-gradient-brand);-webkit-background-clip:text;background-clip:text;color:transparent;">you're the answer.</span></h1>
      <p style="margin:0;font-size:16px;line-height:1.6;color:rgba(15,15,18,0.70);">One clear story about your business, everywhere the machines look.</p>
      <rz-orb-button href={u("/contact/")} height="52" padding="32">Book a Call</rz-orb-button>
    </div>

    <div style="background:linear-gradient(180deg,#FAFAFA 0%,#E3E4ED 48%,#FAFAFA 82%,#FAFAFA 100%);">
