---
import LeadReportForm from '../LeadReportForm.astro';
const items = [
  'Your top three fixes, in the order to do them.',
  'Which website pages to remove, rework, strengthen or build.',
  'A rewritten Google Business Profile description, services list and post ideas.',
  'How the links pointing at your site compare with local competitors.',
];
---
<div style="padding:48px 16px 32px;display:flex;flex-direction:column;gap:20px;">
      <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);">Free Local Visibility Report</span>
      <h1 style="margin:0;font-family:var(--rz-font-display);font-weight:700;font-size:40px;line-height:1.08;letter-spacing:-0.02em;color:var(--rz-background);">See what's keeping you out of the <span style="background:var(--rz-gradient-brand);-webkit-background-clip:text;background-clip:text;color:transparent;">map pack.</span></h1>
      <p style="margin:0;font-size:16px;line-height:1.6;color:rgba(15,15,18,0.70);">We read your website and Google Business Profile, check them against what Google Maps, AI Overviews and ChatGPT look for, and email you a plain-English plan.</p>
    </div>

    <div style="margin:0 16px 32px;background:#F2F2F5;border:1px solid rgba(15,15,18,0.08);border-radius:14px;padding:20px;position:relative;">
      <LeadReportForm variant="m" />
    </div>

    <div style="padding:0 16px 48px;display:flex;flex-direction:column;">
      <span style="font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--rz-slate-dark);margin-bottom:4px;">In your report</span>
      {items.map((text, i) => (
        <div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid rgba(15,15,18,0.10);">
          <span style="font-size:11px;font-weight:600;letter-spacing:0.18em;color:var(--rz-slate-dark);padding-top:4px;">{String(i + 1).padStart(2, '0')}</span>
          <p style="margin:0;font-size:15px;line-height:1.55;color:var(--rz-background);">{text}</p>
        </div>
      ))}
    </div>
