---
import { sections } from '../data/site';
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<div class="m-header" style="position:sticky;top:0;z-index:50;">
  <div class="hdr-bar" style="background:var(--rz-foreground);border-bottom:1px solid rgba(15,15,18,0.10);padding:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <a href={u('/')} aria-label="Raiz Visibility home" style="display:flex;flex-direction:column;gap:4px;width:96px;">
      <span class="hdr-word" style="font-family:var(--rz-font-display);font-weight:700;font-size:25px;line-height:1;letter-spacing:-0.01em;background:var(--rz-gradient-brand-on-light);-webkit-background-clip:text;background-clip:text;color:transparent;">RAIZ</span>
      <span class="hdr-sub" style="font-family:var(--rz-font-display);font-weight:400;font-size:6px;letter-spacing:0.5em;color:var(--rz-background);padding-left:3px;">VISIBILITY</span>
    </a>
    <div style="display:flex;align-items:center;gap:12px;">
      <a href={u('/#contact')} data-section-link="contact" class="hdr-cta" style="display:inline-flex;align-items:center;height:40px;padding:0 18px;border-radius:10px;background:var(--rz-purple);color:var(--rz-foreground);font-size:13.5px;font-weight:500;">Contact</a>
      <button type="button" class="m-menu-toggle hdr-icon" aria-expanded="false" aria-controls="m-menu" aria-label="Open menu" style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--rz-background);background:none;border:0;padding:0;cursor:pointer;">
        <svg class="m-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
        <svg class="m-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
  </div>

  <!-- Menu panel: not drawn in the design; lists the one-page sections. -->
  <nav id="m-menu" class="m-menu" hidden style="position:absolute;left:0;right:0;top:100%;background:var(--rz-foreground);border-bottom:1px solid rgba(15,15,18,0.10);box-shadow:0 24px 48px rgba(15,15,18,0.10);padding:8px 16px 24px;max-height:calc(100dvh - 77px);overflow-y:auto;">
    <div style="display:flex;flex-direction:column;padding-top:8px;">
      {sections.map((s) => (
        <a href={u(`/#${s.id}`)} data-section-link={s.id} style="padding:14px 0;border-bottom:1px solid rgba(15,15,18,0.08);font-family:var(--rz-font-display);font-size:18px;font-weight:500;color:var(--rz-background);">{s.label}</a>
      ))}
      <a href={u("/#contact")} data-section-link="contact" style="padding:14px 0;font-family:var(--rz-font-display);font-size:18px;font-weight:500;color:var(--rz-background);">Contact</a>
    </div>
  </nav>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.m-menu-toggle').forEach((btn) => {
    const menu = document.getElementById(btn.getAttribute('aria-controls')!)!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  });
</script>
