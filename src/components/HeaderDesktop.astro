---
import { sections } from '../data/site';
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---
<header style="background:var(--rz-foreground);border-bottom:1px solid rgba(15,15,18,0.10);position:relative;z-index:20;">
      <div style="margin:0 auto;padding:23px 72px;display:flex;align-items:center;justify-content:space-between;gap:32px;">
        <a href={u("/")} aria-label="Raiz Visibility home" style="display:flex;flex-direction:column;align-items:center;gap:5px;width:130px;">
          <span style="font-family:var(--rz-font-display);font-weight:700;font-size:34px;line-height:1;letter-spacing:-0.01em;background:var(--rz-gradient-brand-on-light);-webkit-background-clip:text;background-clip:text;color:transparent;">RAIZ</span>
          <span style="font-family:var(--rz-font-display);font-weight:400;font-size:8px;letter-spacing:0.5em;color:var(--rz-background);padding-left:4px;">VISIBILITY</span>
        </a>

        <nav aria-label="Main" style="display:flex;align-items:center;gap:32px;margin-left:auto;margin-right:32px;">
          {sections.map((s) => (
            <a href={u(`/#${s.id}`)} data-section-link={s.id} style="font-size:15px;color:var(--rz-background);">{s.label}</a>
          ))}
        </nav>

        <a href={u("/#contact")} data-section-link="contact" style="display:inline-flex;align-items:center;height:44px;padding:0 24px;border-radius:10px;background:var(--rz-purple);color:var(--rz-foreground);font-size:14.5px;font-weight:500;" class="hv-27">Contact</a>
      </div>
    </header>
